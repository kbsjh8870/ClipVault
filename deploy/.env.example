# 이 파일을 deploy/.env 로 복사해서 값을 채운다. deploy/.env 는 .gitignore 대상이라 git에 올라가지 않는다.

# 서버 주소(도메인). 도메인이 없으면 VM 공인 IP를 sslip.io 형식으로 쓰면 된다.
# 예: 공인 IP가 140.238.1.2 이면 → 140-238-1-2.sslip.io
DOMAIN=140-238-1-2.sslip.io

# Neon PostgreSQL (JDBC 형식, 호스트에 -pooler 없이)
DB_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=

# 생성: openssl rand -base64 48
JWT_SECRET=
# 생성: openssl rand -base64 32   (잃어버리면 저장된 클립을 복호화할 수 없으니 따로 백업)
CLIP_ENCRYPTION_KEY=

# 이미지 저장소: Oracle Object Storage (S3 호환). 비워 두면 이미지 업로드가 실패한다(컨테이너 폴더에 쓸 권한 없음).
# 엔드포인트: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_ENDPOINT=
S3_REGION=ap-chuncheon-1
S3_BUCKET=clipvault-images
# 사용자 프로필 → Customer secret keys 에서 발급
S3_ACCESS_KEY=
S3_SECRET_KEY=
